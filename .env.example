# Jumble environment variables
# Copy this file to .env (or .env.local) and adjust as needed.
# Variables MUST be prefixed with VITE_ to be exposed to the client.

# ---- HiveRelay (L402 paid video rooms) --------------------------------------
# REST API base URL for HiveRelay. Production default is built in; override
# here to point at a staging relay.
#VITE_HIVERELAY_API_BASE=https://relay.hivetalk.org

# WebSocket URL for publishing kind-30312 room announcements.
#VITE_HIVERELAY_RELAY_URL=wss://relay.hivetalk.org/

# Staging example (uncomment to use the staging relay):
#VITE_HIVERELAY_API_BASE=https://l402relay.exe.xyz
#VITE_HIVERELAY_RELAY_URL=wss://l402relay.exe.xyz/

# ---- Link preview metadata service ------------------------------------------
# Override the link preview server used for URL metadata fetching.
#VITE_LINK_PREVIEW_SERVER=https://scout.jumble.social

# ---- Community mode ---------------------------------------------------------
# When set, the app runs in community mode with the specified relay sets/relays.
#VITE_COMMUNITY_RELAY_SETS=
#VITE_COMMUNITY_RELAYS=

# ---- Klipy (GIF/emoji) API key ----------------------------------------------
#VITE_KLIPY_API_KEY=
